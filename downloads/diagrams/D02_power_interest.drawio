rcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#000000;strokeColor=#000000;ellipse;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="174" y="132" width="52" height="36" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Key&lt;/b&gt;&lt;br&gt;&lt;b&gt;S01&lt;/b&gt; Deputy Vice-Chancellor (Education) (P5/I5)&lt;br&gt;&lt;b&gt;S02&lt;/b&gt; Chief Information Officer (P5/I4)&lt;br&gt;&lt;b&gt;S03&lt;/b&gt; Academic Registrar (P4/I5)&lt;br&gt;&lt;b&gt;S04&lt;/b&gt; Faculty Deans (P4/I3)&lt;br&gt;&lt;b&gt;S05&lt;/b&gt; Students (domestic &amp;amp; international) (P2/I5)&lt;br&gt;&lt;b&gt;S06&lt;/b&gt; Student Representative Council (SRC) (P3/I4)&lt;br&gt;&lt;b&gt;S07&lt;/b&gt; Academic staff (P2/I3)&lt;br&gt;&lt;b&gt;S08&lt;/b&gt; IT Service Desk (P2/I4)&lt;br&gt;&lt;b&gt;S09&lt;/b&gt; Finance Office (P4/I3)&lt;br&gt;&lt;b&gt;S10&lt;/b&gt; Privacy Officer (P4/I4)&lt;br&gt;&lt;b&gt;S11&lt;/b&gt; Accessibility Services (P2/I4)&lt;br&gt;&lt;b&gt;S12&lt;/b&gt; LMS vendor (P4/I2)&lt;br&gt;&lt;b&gt;S13&lt;/b&gt; Portal platform vendor (P3/I4)&lt;br&gt;&lt;b&gt;S14&lt;/b&gt; TEQSA (regulator) (P5/I1)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#000000;strokeColor=#000000;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="960" y="70" width="500" height="520" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;What it means:&lt;/b&gt; we manage the sponsor, CIO, Registrar and Privacy Officer closely because any of them can stop or change the project (money, architecture, student data, privacy). Students care a lot but don't have much power, so we keep them informed and they get a voice through the SRC." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#000000;strokeColor=#000000;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="960" y="600" width="500" height="150" as="geometry"/></mxCell><mxCell id="c40" value="Prepared by: &lt;b&gt;Sabikunnhar&lt;/b&gt; · BISY2004 Assessment 2 · Group XX" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#000000;strokeColor=#000000;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="900" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>